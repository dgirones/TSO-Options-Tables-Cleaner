#. Privacy policy plugin name
msgid "TSO Options & Tables Cleaner"
msgstr ""

#. Privacy policy paragraph 1
msgid "This plugin stores one administrator preference: the interface language (Catalan, Spanish, or English). It is saved as user metadata (<code>wp_usermeta</code>, key: <code>tso_ui_lang</code>) only for the user who selected the language. No data is sent to external servers."
msgstr ""

#. Privacy policy paragraph 2
msgid "If you use the Backup tab, generated SQL files are stored locally under your uploads directory (typically <code>wp-content/uploads/tso-options-tables-cleaner/backups/</code>) and are not transmitted to third-party services. Uninstalling the plugin removes that uploads folder (download backups first if you need to keep them)."
msgstr ""

